DATA_BLOCK "DB_FIFO"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      Botella : Array[0..3] of "UDT_Botella";   // 4 posiciones = maximo 4 botellas a la vez. Se usa en circulo: despues de la 3 vuelve a la 0.
      Ptr_Entrada : Int := 0;   // Posicion donde se guardara la proxima botella que salga del generador.
      Idx_Z1 : Int := 0;   // Posicion del FIFO de la botella que esta en la zona 1.
      Idx_Z2 : Int := 0;   // Posicion del FIFO de la botella que esta en la zona 2.
      Idx_Z3 : Int := 0;   // Posicion del FIFO de la botella que esta en la zona 3.
      Idx_Z4 : Int := 0;   // Posicion del FIFO de la botella que esta en la zona 4.
      N_Botellas : Int := 0;   // Botellas que hay ahora en la linea.
      Siguiente_ID : Int := 1;   // Numero que llevara la proxima botella.
   END_VAR

BEGIN

END_DATA_BLOCK
